generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  googleId     String?    @unique @map("google_id")
  displayName  String     @map("display_name")
  nativeLang   String     @default("fr") @map("native_lang")
  targetLang   String     @default("de") @map("target_lang")
  avatarUrl    String?    @map("avatar_url")
  isVerified   Boolean    @default(false) @map("is_verified")
  verifyToken  String?    @map("verify_token")
  resetToken   String?    @map("reset_token")
  resetExpires DateTime?  @map("reset_expires")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  userBooks    UserBook[]

  @@map("users")
}

model Book {
  id            String     @id @default(uuid())
  slug          String     @unique
  title         String
  author        String
  description   String?
  coverColor    String     @default("soleil") @map("cover_color")
  coverImage    String?    @map("cover_image")
  publisher     String     @default("Gallimard / Domaine Public")
  language      String     @default("fr")
  cefrLevel     String     @default("B1") @map("cefr_level")
  year          Int        @default(1943)
  genre         String     @default("Conte philosophique")
  totalChapters Int        @default(1) @map("total_chapters")
  totalWords    Int        @default(0) @map("total_words")
  createdAt     DateTime   @default(now()) @map("created_at")

  chapters      Chapter[]
  userBooks     UserBook[]

  @@map("books")
}

model Chapter {
  id          String   @id @default(uuid())
  bookId      String   @map("book_id")
  number      Int
  title       String
  contentHtml String   @map("content_html")
  wordCount   Int      @default(0) @map("word_count")
  audioUrl    String?  @map("audio_url")
  createdAt   DateTime @default(now()) @map("created_at")

  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, number])
  @@map("chapters")
}

model UserBook {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  bookId          String   @map("book_id")
  currentChapter  Int      @default(1) @map("current_chapter")
  progressPercent Float    @default(0) @map("progress_percent")
  lastReadAt      DateTime @default(now()) @map("last_read_at")
  addedAt         DateTime @default(now()) @map("added_at")
  status          String   @default("reading")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("user_books")
}
